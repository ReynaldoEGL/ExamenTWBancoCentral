# Copiar estas variables al .env local. No subir .env a GitHub.
APP_NAME="Banco Central"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Proyecto Supabase PRINCIPAL del Banco Central
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLIC_KEY=sb_publishable_REEMPLAZAR_POR_LA_CLAVE_PUBLICA

# Use el connection string de Session pooler (normalmente puerto 5432).
# Tome host y usuario desde Supabase > Connect; no invente el host.
DB_CONNECTION=pgsql
DB_HOST=POOLER_HOST_COPIADO_DE_SUPABASE
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=REEMPLAZAR_POR_LA_CONTRASENA_DE_POSTGRES
DB_SSLMODE=require

# Evitar que Laravel requiera tablas locales de sesiones/cache/colas.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
